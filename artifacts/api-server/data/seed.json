[
  {"number":1,"line1":"அகர முதல எழுத்தெல்லாம் ஆதி","line2":"பகவன் முதற்றே உலகு"},
  {"number":2,"line1":"கற்றதனால் ஆய பயனென்கொல் வாலறிவன்","line2":"நற்றாள் தொழாஅர் எனின்"},
  {"number":10,"line1":"பிறவிப் பெருங்கடல் நீந்துவர் நீந்தார்","line2":"இறைவன் அடிசேரா தார்"},
  {"number":34,"line1":"மனத்துக்கண் மாசிலன் ஆதல் அனைத்தறன்","line2":"ஆகுல நீர பிற"},
  {"number":72,"line1":"அன்பிலார் எல்லாம் தமக்குரியர் அன்புடையார்","line2":"என்பும் உரியர் பிறர்க்கு"},
  {"number":100,"line1":"இனிய உளவாக இன்னாத கூறல்","line2":"கனிஇருப்ப காய்கவர்ந் தற்று"},
  {"number":236,"line1":"தோன்றின் புகழொடு தோன்றுக அஃதிலார்","line2":"தோன்றலின் தோன்றாமை நன்று"},
  {"number":300,"line1":"யாம்மெய்யாக் கண்டவற்றுள் இல்லை எனைத்தொன்றும்","line2":"வாய்மையின் நல்ல பிற"},
  {"number":314,"line1":"இன்னாசெய் தாரை ஒறுத்தல் அவர்நாண","line2":"நன்னயம் செய்து விடல்"},
  {"number":322,"line1":"பகுத்துண்டு பல்லுயிர் ஓம்புதல் நூலோர்","line2":"தொகுத்தவற்றுள் எல்லாம் தலை"},
  {"number":391,"line1":"கற்க கசடறக் கற்பவை","line2":"கற்றபின் நிற்க அதற்குத் தக"},
  {"number":396,"line1":"தொட்டனைத் தூறும் மணற்கேணி மாந்தர்க்குக்","line2":"கற்றனைத் தூறும் அறிவு"},
  {"number":423,"line1":"எப்பொருள் யார்யார்வாய்க் கேட்பினும் அப்பொருள்","line2":"மெய்ப்பொருள் காண்பது அறிவு"},
  {"number":595,"line1":"வெள்ளத் தனைய மலர்நீட்டம் மாந்தர்தம்","line2":"உள்ளத் தனையது உயர்வு"},
  {"number":616,"line1":"முயற்சி திருவினை ஆக்கும் முயற்றின்மை","line2":"இன்மை புகுத்தி விடும்"},
  {"number":620,"line1":"ஊழையும் உப்பக்கம் காண்பர் உலைவின்றித்","line2":"தாழாது உஞற்று பவர்"},
  {"number":666,"line1":"எண்ணிய எண்ணியாங் கெய்துப எண்ணியார்","line2":"திண்ணியராப் பெற்றாக்கால்"},
  {"number":1330,"line1":"ஊடுதல் காமத்திற்கு இன்பம் அதற்கின்பம்","line2":"கூடி முயங்கப் பெறின்"}
]
